HEM_DATABASE=data/hem.sqlite3
# Keep this disabled until you explicitly want the server to send real replies.
HEM_SEND_MESSAGES=false
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
# Optional local HTTP simulator; a long random token is required to enable it.
HEM_DEV_TOKEN=
# Vision and conversational styling (image-capable Responses API model).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Exact trusted CDN hosts for inbound garment photos. Redirects are rejected.
HEM_MEDIA_HOSTS=cdn.linqapp.com
# Additional exact publisher hosts allowed for source <HTTPS feed URL>.
HEM_SOURCE_HOSTS=
# Optional vector database. Embedding generation is a separate next step.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hem_fashion
